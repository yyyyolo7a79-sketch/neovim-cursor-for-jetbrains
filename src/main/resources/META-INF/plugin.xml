<?xml version="1.0" encoding="UTF-8"?>
<idea-plugin>
    <id>com.github.yyyolo7a79.neovidecursor</id>
    <name>Neovide Cursor</name>
    <vendor>yyyyolo7a79</vendor>

    <description><![CDATA[
    Neovide 风格「拖尾光标」—— 光标移动时留下渐隐的拉伸残影，带辉光效果。
    <br/>
    参数语义与 VS Code 版 neovide-cursor 保持一致，便于跨平台迁移配置。
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- 拖尾光标主入口：为每个编辑器挂载动画覆盖层 -->
        <editorFactoryListener implementation="com.github.yyyolo7a79.neovidecursor.ui.NeovideCaretManager"/>
    </extensions>

    <actions>
        <action id="NeovideCursor.Toggle"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleNeovideAction"
                text="Neovide 拖尾光标（开关）"
                description="启用或禁用拖尾光标效果；关闭时会恢复原生光标">
            <add-to-group group-id="ToolsMenu" anchor="first"/>
        </action>

        <action id="NeovideCursor.PaintDiag"
                class="com.github.yyyolo7a79.neovidecursor.ui.TogglePaintDiagAction"
                text="Neovide 光标：性能诊断（禁用重绘）"
                description="跳过重绘只跑计算，用于分离瓶颈：是绘制慢还是 EDT 调度慢">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="NeovideCursor.TrailMode"
                class="com.github.yyyolo7a79.neovidecursor.ui.ToggleTrailModeAction"
                text="Neovide 光标：残影模式（低帧率更稳）"
                description="勾选切换到残影轨迹模型（记录真实历史位置，掉帧不失真）；取消则回到弹簧拉伸模型（Neovide 原版效果）">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
